# Supabase PostgreSQL connection string.
# Prefer the transaction/session pooler connection string supplied by Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-side verification request key. Do NOT put service_role in the iOS app.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Yahoo! Shopping Web API Client ID
YAHOO_APP_ID=YOUR_YAHOO_CLIENT_ID


# Stripe secret key. Backend only. Never put this in the iOS app.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret. Backend only.
STRIPE_WEBHOOK_SECRET=whsec_xxx
